# Copie para .env e preencha com as credenciais do seu projeto Supabase.
# No Vercel: Project Settings → Environment Variables.
# Onde encontrar: Supabase → Settings → API.
#
# A "VITE_SUPABASE_PUBLISHABLE_KEY" aceita tanto o formato novo
# (`sb_publishable_...`) quanto o antigo (JWT `eyJ...` da anon key).
# Ambos são seguros para uso no frontend.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
