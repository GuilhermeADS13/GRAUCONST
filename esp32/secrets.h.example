// ============================================================
//  Copie este arquivo para `secrets.h` e preencha com seus dados.
//  `secrets.h` está no .gitignore — não será commitado.
// ============================================================
#pragma once

// ── WiFi ─────────────────────────────────────────────────────
#define WIFI_SSID      "SEU_SSID_AQUI"
#define WIFI_PASSWORD  "SUA_SENHA_AQUI"

// ── Supabase ─────────────────────────────────────────────────
// URL do projeto (Settings → API → Project URL).
#define SUPABASE_URL   "https://XXXXXXXXXXXX.supabase.co"

// Token compartilhado de dispositivo. Tem que ser idêntico ao secret
// DEVICE_TOKEN configurado no Supabase (Dashboard → Project Settings →
// Edge Functions → Secrets). NÃO use a anon/publishable key aqui.
// Gere um valor forte com: openssl rand -hex 32
#define DEVICE_TOKEN   "cole_aqui_o_mesmo_token_do_supabase"

// ── Identificador do sensor ──────────────────────────────────
// Opcional. Se vazio, gera automaticamente "ESP32-<MAC sem ':'>" — útil
// para múltiplos sensores sem precisar reflash. Defina explicitamente só
// se quiser um label amigável (ex.: "Sala", "Cozinha").
#define SENSOR_ID      ""

// ── Bateria (opcional) ───────────────────────────────────────
// Pino do ADC para ler tensão da bateria. Comente para desativar
// (sensor por USB/fonte → bateria_pct fica NULL no banco).
// Requer divisor de tensão: VCC_BAT -- R1 -- ADC -- R2 -- GND.
//#define BATTERY_PIN       35
//#define BATTERY_DIVIDER   2.0f  // (R1+R2)/R2
