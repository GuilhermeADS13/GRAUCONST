// ============================================================
//  Copie este arquivo para `secrets.h` e preencha com seus dados.
//  `secrets.h` está no .gitignore — não será commitado.
// ============================================================
#pragma once

// ── WiFi ─────────────────────────────────────────────────────
// Rede principal (obrigatória).
#define WIFI_SSID      "SEU_SSID_AQUI"
#define WIFI_PASSWORD  "SUA_SENHA_AQUI"
// (Opcional) Redes extras de backup — o ESP32 conecta na mais forte
// disponível entre todas. Descomente e preencha quantas quiser (até a 3ª aqui;
// pra mais, é só seguir o padrão no firmware).
//#define WIFI_SSID2     "SEGUNDA_REDE"
//#define WIFI_PASSWORD2 "SENHA_DA_SEGUNDA"
//#define WIFI_SSID3     "TERCEIRA_REDE"
//#define WIFI_PASSWORD3 "SENHA_DA_TERCEIRA"

// ── Supabase ─────────────────────────────────────────────────
// URL do projeto (Settings → API → Project URL).
#define SUPABASE_URL   "https://XXXXXXXXXXXX.supabase.co"

// Token compartilhado de dispositivo. Tem que ser idêntico ao secret
// DEVICE_TOKEN configurado no Supabase (Dashboard → Project Settings →
// Edge Functions → Secrets). NÃO use a anon/publishable key aqui.
// Gere um valor forte com: openssl rand -hex 32
#define DEVICE_TOKEN   "cole_aqui_o_mesmo_token_do_supabase"

// ── Identificador do sensor ──────────────────────────────────
// Opcional. Se vazio, gera automaticamente "ESP32-<MAC sem ':'>" — útil
// para múltiplos sensores sem precisar reflash. Defina explicitamente só
// se quiser um label amigável (ex.: "Sala", "Cozinha").
#define SENSOR_ID      ""

// ── Inkbird IBS-TH2 (BLE) ────────────────────────────────────
// Tempo do scan BLE, em segundos.
#define BLE_SCAN_TIME  20
// (Opcional, recomendado) Trava a detecção no MAC do SEU Inkbird, ignorando
// qualquer outro dispositivo Bluetooth por perto. Pegue o MAC na linha [SCAN]
// do Monitor Serial (o de RSSI mais forte, nome "sps"/"tps"). Sem isto, a
// detecção é por nome — funciona, mas é menos específica.
//#define INKBIRD_MAC    "49:25:12:12:08:5C"

// ── Bateria (opcional) ───────────────────────────────────────
// Pino do ADC para ler tensão da bateria. Comente para desativar
// (sensor por USB/fonte → bateria_pct fica NULL no banco).
// Requer divisor de tensão: VCC_BAT -- R1 -- ADC -- R2 -- GND.
//#define BATTERY_PIN       35
//#define BATTERY_DIVIDER   2.0f  // (R1+R2)/R2

// ── Firmware version ─────────────────────────────────────────
// Versão atual do firmware. Bump a cada release para que o ESP32
// detecte a atualização OTA. Formato livre — comparação é string.
#define FIRMWARE_VERSION  "1.0.0"

// ── OTA via Supabase Storage (opcional) ──────────────────────
// Bucket público "firmware" com dois arquivos:
//   - version.json  → { "version": "1.0.1", "url": "URL_PUBLICA_DO_BIN" }
//   - firmware.bin  → binário gerado pelo Arduino IDE (Sketch → Export)
//
// O ESP32 consulta version.json a cada OTA_CHECK_EVERY_N_BOOTS boots.
// Se a versão remota for diferente da local, baixa firmware.bin e
// reinicia. Se o bucket/arquivo não existir, o check falha silencioso
// e o firmware segue operando normalmente.
//
// Para desativar OTA, comente OTA_VERSION_URL.
#define OTA_VERSION_URL          SUPABASE_URL "/storage/v1/object/public/firmware/version.json"
#define OTA_CHECK_EVERY_N_BOOTS  10   // a cada 10 boots (~2.5h)

// ── TLS / HTTPS ──────────────────────────────────────────────
// Por padrão valida o certificado do Supabase contra ISRG Root X1
// (Let's Encrypt). Se a validação começar a falhar (CA rotacionada),
// descomente para fallback inseguro: HTTPS criptografado mas sem
// verificação de identidade do servidor.
//#define SKIP_TLS_VERIFY
