// ── Supabase ─────────────────────────────────────────────────
#define SUPABASE_URL   "https://XXXXXXXXXXXX.supabase.co"
#define DEVICE_TOKEN   "cole_aqui_o_mesmo_token_do_supabase"

// ── Identificador do sensor ──────────────────────────────────
// Deixe vazio para gerar automaticamente "ESP32-<MAC>".
#define SENSOR_ID      ""

// ── Inkbird IBS-TH2 (BLE) ────────────────────────────────────
#define BLE_SCAN_TIME  20
//#define INKBIRD_MAC    "49:25:12:12:08:5C"

// ── Bateria do ESP32 (pack 2S — divisor resistivo) ───────────
//
//  Circuito:
//    VCC_BAT (+) ── 100kΩ ── GPIO34 ── 47kΩ ── GND
//
//  Com esse divisor:
//    Vpin = Vbat × 47/(100+47) ≈ Vbat × 0.3197
//    Vbat 8.4V (cheio)  → Vpin ≈ 2.69V  (seguro para o ADC de 3.3V)
//    Vbat 6.0V (vazio)  → Vpin ≈ 1.92V
//
//  O firmware faz a conversão e envia esp32_bat_pct (0–100%) ao Supabase.
//  Descomente BATTERY_PIN para ativar. Sem ele, esp32_bat_pct fica NULL.
//
#define BATTERY_PIN  34

// ── OTA via Supabase Storage (opcional) ──────────────────────
#define OTA_VERSION_URL          SUPABASE_URL "/storage/v1/object/public/firmware/version.json"
#define OTA_CHECK_EVERY_N_BOOTS  10

